EDFD Bank[
    assets:
        Asset  Password
            type: String
            values: [ L P ] source: "E1: Applicant"
            targets: "P1: Login" ,

        Asset ID
            type: Number
            values:  [ H P ] source: "E1: Applicant"
            targets: "P1: Login" ,

        Asset "credit history"
            type: Object
            values:  [ M P ] source: "D1: DB"
            targets: "E1: Applicant" , "P2: show Overview" ,

        Asset token
            type: Number
            values:  [ L P ]
            source: "P1: Login"
            targets: "E1: Applicant" , "P3: credit application" ,

         Asset payments
            type: Object
            values: [ M P ]
            source: "E4: Bank system"
            targets: "D1: DB" ,

        Asset "credit decision"
            type: String
            source: "P9: approve or revise decision (R3)"
            targets: "P10: show request result" , "D1: DB" ,
                     "E2: scoring provider" ,

        Asset "decision details"
            type: String
            source: "P10: show request result"
            targets: "E1: Applicant" ,

        Asset "preliminary decision"
            type: String
            source: "P6: loan decision (AI) R1"
            targets: "P10: show request result" , "D1: DB" ,
                     "P9: approve or revise decision (R3)" ,
                     "E3: Employee" ,

         Asset "asset category"
            type: String
            values: [ N P ]
            source: "D1: DB"
            targets: "P10: show request result" ,
                     "P6: loan decision (AI) R1" ,
                     "E2: scoring provider" ,

        Asset "asset data"
            type: Object
            values: [ L P ]
            source: "E1: Applicant"
            targets: "P3: credit application" ,
                     "P4: calculate asset risk score (AI) - R1.2" ,

        Asset "applicant data"
            type: String
            values: [ H P ]
            source: "E1: Applicant"
            targets: "P3: credit application" ,
                     "P5: calculate applicant risk score (AI) (R1.1, R1.2, R1.4)" ,
                     "D1: DB" ,

        Asset "payment history"
            type: String
            values: [ M P ]
            source: "D1: DB"
            targets: "P5: calculate applicant risk score (AI) (R1.1, R1.2, R1.4)" ,

        Asset "asset risk score"
            type: String
            source: "P4: calculate asset risk score (AI) - R1.2"
            targets: "P6: loan decision (AI) R1" ,

        Asset "applicant risk score"
            type: String
            source: "P5: calculate applicant risk score (AI) (R1.1, R1.2, R1.4)"
            targets: "P6: loan decision (AI) R1" ,

        Asset confidence
            type: String
            source: "P6: loan decision (AI) R1"
            targets: "P9: approve or revise decision (R3)" ,
                     "E3: Employee" ,

        Asset "aggregated data"
            type: String
            source: "P6: loan decision (AI) R1"
            targets: "P9: approve or revise decision (R3)" ,
                     "E3: Employee" ,

        Asset decision
            type: String
            source: "E3: Employee"
            targets: "P9: approve or revise decision (R3)" ,

        Asset name
            type: String
            source: "P3: credit application"
            targets: "P7: get score (R 1.5)" , "E2: scoring provider" ,

        Asset address
            type: String
            source: "P3: credit application"
            targets: "P7: get score (R 1.5)" , "E2: scoring provider" ,

        Asset "date of birth"
            type: String
            source: "P3: credit application"
            targets: "P7: get score (R 1.5)" , "E2: scoring provider" ,

        Asset "external credit score"
            type: String
            values: [ M P ] source: "E2: scoring provider"
            targets: "P6: loan decision (AI) R1" ,
                     "P7: get score (R 1.5)" ,

        Asset "info of application"
            type: String
            source: "P7: get score (R 1.5)"
            targets: "E2: scoring provider"

    elements:
        Process "P1: Login"
            [ assets: Password , ID , token
              incoming flows: "E1: Applicant.F1: id, password"
              outgoing flows: "F2: token"
                  [ assets: token
                    source: "P1: Login"
                    targets: "E1: Applicant" ] ] ,

        ExternalEntity "E1: Applicant"
            [ assets: Password , ID , "credit history" , token ,
                      "decision details" , "asset data"
              incoming flows:
                  "P2: show Overview.F3: credit history" ,
                  "P1: Login.F2: token" ,
                  "P10: show request result.F9: decision details"
              outgoing flows:
                  "F1: id, password"
                      [ assets: Password , ID
                        source: "E1: Applicant"
                        targets: "P1: Login" ] ,
                  "F10: token, asset data, applicant data"
                      [ assets: token , "asset data" , "applicant data"
                        source: "E1: Applicant"
                        targets: "P3: credit application" ] ] ,

        Process "P2: show Overview"
            [ assets: "credit history" incoming flows: "D1: DB.F4: credit history" outgoing flows: "F3: credit history"
                      [ assets: "credit history"
                        source: "P2: show Overview"
                        targets: "E1: Applicant" ] ] ,

        DataStore "D1: DB"
            [ assets: "credit history" , payments , "credit decision" ,
                      "preliminary decision" , "asset category" ,
                      "payment history" , "asset data" ,
                      "applicant data" incoming flows: "E4: Bank system.F7: payments" ,
                  "P3: credit application.F11: asset data, applicant data" ,
                  "P6: loan decision (AI) R1.F17: preliminary decision" ,
                  "P9: approve or revise decision (R3).F21: credit decision" outgoing flows: "F4: credit history"
                      [ assets: "credit history"
                        source: "D1: DB"
                        targets: "P2: show Overview" ] ,
                  "F8: preliminary decision, credit decision, need for approval, asset category"
                      [ assets: "credit decision" , "preliminary decision" ,
                                "asset category" source: "D1: DB"
                        targets: "P10: show request result" ] ,
                  "F13: credit history, payment history"
                      [ assets: "credit history" , "payment history"
                        source: "D1: DB"
                        targets: "P5: calculate applicant risk score (AI) (R1.1, R1.2, R1.4)" ] ,
                  "F20: preliminary decision, confidence, aggregated data"
                      [ assets: "preliminary decision" , confidence , "aggregated data"
                        source: "D1: DB"
                        targets: "P9: approve or revise decision (R3)" ] ] ,

         ExternalEntity "E4: Bank system"
            [ outgoing flows:
                  "F7: payments"
                      [ assets: payments
                        source: "E4: Bank system"
                        targets: "D1: DB" ] ] ,

        Process "P10: show request result"
            [ assets: "credit decision" , "preliminary decision" ,
                      "asset category" incoming flows: "D1: DB.F8: preliminary decision, credit decision, need for approval, asset category"
              outgoing flows:
                  "F9: decision details"
                      [ assets: "decision details"
                        source: "P10: show request result"
                        targets: "E1: Applicant" ] ] ,

        Process "P3: credit application"
            [ assets: "asset data" , token , "applicant data" ,
                      "asset category" , name , "date of birth" , address
              incoming flows:
                  "E1: Applicant.F10: token, asset data, applicant data"
              outgoing flows:
                  "F11: asset data, applicant data"
                      [ assets: "asset data" , "applicant data"
                        source: "P3: credit application"
                        targets: "D1: DB" ] ,
                  "F12: applicant data"
                      [ assets: "applicant data"
                        source: "P3: credit application"
                        targets: "P5: calculate applicant risk score (AI) (R1.1, R1.2, R1.4)" ] ,
                  "F13: asset data"
                      [ assets: "asset data"
                        source: "P3: credit application"
                        targets: "P4: calculate asset risk score (AI) - R1.2" ] ,
                  "F14: asset category"
                      [ assets: "asset category"
                        source: "P3: credit application"
                        targets: "P6: loan decision (AI) R1" ] ,
                  "F25: name, address, date of birth"
                      [ assets: name , address , "date of birth"
                        source: "P3: credit application"
                        targets: "P7: get score (R 1.5)" ] ] ,

        Process "P5: calculate applicant risk score (AI) (R1.1, R1.2, R1.4)"
            [ contracts: ClassificationFixed [ "applicant data" PModel = M :: "applicant risk score" ] assets: "payment history" , "credit history" ,
                      "applicant data" , "applicant risk score"
              incoming flows:
                  "D1: DB.F13: credit history, payment history" ,
                  "P3: credit application.F12: applicant data"
              outgoing flows:
                  "F16: applicant risk score"
                      [ assets: "applicant risk score"
                        source: "P5: calculate applicant risk score (AI) (R1.1, R1.2, R1.4)"
                        targets: "P6: loan decision (AI) R1" ] ] ,

        Process "P4: calculate asset risk score (AI) - R1.2"
            [ contracts: ClassificationFixed [ "asset data" :: "asset risk score" ] assets: "asset data" , "asset risk score"
              incoming flows:
                  "P3: credit application.F13: asset data"
              outgoing flows:
                  "F15: asset risk score"
                      [ assets: "asset risk score"
                        source: "P4: calculate asset risk score (AI) - R1.2"
                        targets: "P6: loan decision (AI) R1" ] ] ,

        Process "P6: loan decision (AI) R1"
            [ contracts: Transformation [ "applicant risk score" , "asset category" , "asset risk score" , "external credit score" :: "preliminary decision" ] assets: "asset category" , "asset risk score" ,
                      "applicant risk score" , "preliminary decision" ,
                      confidence , "aggregated data" ,
                      "external credit score"
              incoming flows:
                  "P3: credit application.F14: asset category" ,
                  "P4: calculate asset risk score (AI) - R1.2.F15: asset risk score" ,
                  "P5: calculate applicant risk score (AI) (R1.1, R1.2, R1.4).F16: applicant risk score" ,
                  "P7: get score (R 1.5).F26: external credit score"
              outgoing flows:
                  "F17: preliminary decision"
                      [ assets: "preliminary decision"
                        source: "P6: loan decision (AI) R1"
                        targets: "D1: DB" ] ,
                  "F18: preliminary decision, confidence, aggregated data"
                      [ assets: "preliminary decision" , confidence , "aggregated data"
                        source: "P6: loan decision (AI) R1"
                        ] ] ,

         Process "P9: approve or revise decision (R3)"
            [ assets: "credit decision" , "preliminary decision" ,
                      confidence , "aggregated data" , decision ,
                      name , address , "date of birth" , "asset category"
              incoming flows:
                  "D1: DB.F20: preliminary decision, confidence, aggregated data" ,
                  "E3: Employee.F24: decision"
              outgoing flows:
                  "F21: credit decision"
                      [ assets: "credit decision"
                        source: "P9: approve or revise decision (R3)"
                        targets: "D1: DB" ] ,
                  "F23: preliminary decision, confidence, aggregated data"
                      [ assets: "preliminary decision" , confidence , "aggregated data"
                        source: "P9: approve or revise decision (R3)"
                        targets: "E3: Employee" ] ,
                  "F30: name, address, date of birth, asset category, credit decision"
                      [ assets: name , address , "date of birth" ,
                                "asset category" , "credit decision"
                        source: "P9: approve or revise decision (R3)"
                        targets: "E2: scoring provider" ] ] ,

        ExternalEntity "E3: Employee"
            [ assets: "preliminary decision" , confidence ,
                      "aggregated data" , decision
              incoming flows:
                  "P9: approve or revise decision (R3).F23: preliminary decision, confidence, aggregated data"
              outgoing flows:
                  "F24: decision"
                      [ assets: decision
                        source: "E3: Employee"
                        targets: "P9: approve or revise decision (R3)" ] ] ,

        Process "P7: get score (R 1.5)"
            [ assets: name , address , "date of birth" ,
                      "external credit score" , "info of application"
              incoming flows:
                  "P3: credit application.F25: name, address, date of birth" ,
                  "E2: scoring provider.F27: external credit score"
              outgoing flows:
                  "F26: external credit score"
                      [ assets: "external credit score"
                        source: "P7: get score (R 1.5)"
                        targets: "P6: loan decision (AI) R1" ] ,
                  "F28: name, address, date of birth, info of application"
                      [ assets: name , "date of birth" , address ,
                                "info of application"
                        source: "P7: get score (R 1.5)"
                        targets: "E2: scoring provider" ] ] ,

        ExternalEntity "E2: scoring provider"
            [ assets: "external credit score" , name , address ,
                      "date of birth" , "info of application" ,
                      "credit decision"
              incoming flows:
                  "P7: get score (R 1.5).F28: name, address, date of birth, info of application" ,
                  "P9: approve or revise decision (R3).F30: name, address, date of birth, asset category, credit decision" outgoing flows: "F27: external credit score"
                      [ assets: "external credit score"
                        source: "E2: scoring provider"
                        targets: "P7: get score (R 1.5)" ] ]
]
